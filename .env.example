####################################################################
# Discord moderation bot - environment template
#
# Copy this file to ".env" and fill in real values:
#   cp .env.example .env
#
# Rules:
#   - Never commit ".env" (it is already gitignored).
#   - Never paste real tokens into source files, logs, or chat.
#   - The process reads configuration from the environment only.
####################################################################

# ------------------------------------------------------------------
# Discord application
# ------------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=

# Prefix used when a guild has not chosen one in the setup wizard.
DEFAULT_PREFIX=!

# Slash commands (the / menu) work in every server the bot joins. Default: true.
# Global slash commands can take up to an hour to appear the first time.
ENABLE_SLASH_COMMANDS=true

# Optional: also register slash commands to this one server, where they appear
# immediately. Useful while testing. Leave blank for global only.
# Leave blank to register globally (can take up to one hour to propagate).
SLASH_DEV_GUILD_ID=

# Comma-separated Discord user IDs that may run owner-only commands and
# bypass permission checks. Leave blank for a permission-free bot owner list.
BOT_OWNER_IDS=

# Presence text and type. Types: PLAYING, WATCHING, LISTENING, COMPETING.
BOT_ACTIVITY=Server moderation
BOT_ACTIVITY_TYPE=WATCHING

# ------------------------------------------------------------------
# Cloudflare Worker gateway (the only path to Cloudflare D1)
# The bot never talks to D1 directly; it calls this Worker over HTTPS.
# ------------------------------------------------------------------
# Example: https://moderation-gateway.<your-subdomain>.workers.dev
WORKER_BASE_URL=

# Shared secret. Must match the WORKER_AUTH_TOKEN secret set on the Worker.
WORKER_AUTH_TOKEN=

# Per-request timeout and retry policy for gateway calls.
WORKER_TIMEOUT_MS=10000
WORKER_MAX_RETRIES=3

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# Optional private channel ID where internal errors and stack traces are
# mirrored for maintainers. Never make this channel public. Leave blank to
# disable channel mirroring.
LOG_INTERNAL_CHANNEL_ID=

# Full stack traces are always written to a local file; nothing sensitive
# is printed to stdout or sent to Discord.
LOG_TO_FILE=true
LOG_DIR=logs

# ------------------------------------------------------------------
# Health endpoint (for Wispbyte / uptime monitoring)
# ------------------------------------------------------------------
HEALTH_ENABLED=true
HEALTH_HOST=0.0.0.0
PORT=3000

# ------------------------------------------------------------------
# Command rate limiting (protects the bot and the gateway from abuse)
# ------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_COMMANDS=6
RATE_LIMIT_MAX_MOD_ACTIONS=3

# ------------------------------------------------------------------
# Scheduled action worker (tempmute / tempban / temp role expiry)
# ------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_BATCH_SIZE=25
SCHEDULER_STARTUP_GRACE_MS=5000

# ------------------------------------------------------------------
# Behaviour limits (safety caps, not user configurable)
# ------------------------------------------------------------------
MAX_PURGE_COUNT=1000
MAX_TIMEOUT_DURATION=28d
MAX_TEMPBAN_DURATION=365d

# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------
# Use "production" on Wispbyte. Use "development" when testing locally:
# in production the loader rejects non-HTTPS Worker URLs, so a local
# "http://127.0.0.1:8787" gateway will abort startup. Development also
# raises the log level to "debug".
NODE_ENV=production
TZ=UTC
