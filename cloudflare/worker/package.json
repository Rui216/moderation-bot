{
  "name": "moderation-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated Cloudflare Worker gateway between the Discord moderation bot and Cloudflare D1.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "schema:local": "wrangler d1 execute moderation-bot --local --file=../schema.sql",
    "schema:remote": "wrangler d1 execute moderation-bot --remote --file=../schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
